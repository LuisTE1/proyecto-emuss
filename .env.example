# Copia este archivo a .env y completa con los valores de tu proyecto
# Supabase (Project Settings > API en el dashboard de supabase.com).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Opcional — anti-bots de Cloudflare Turnstile en el formulario de reserva.
# Mientras esta variable no exista, el widget no se muestra (no bloquea
# nada). Site Key desde dash.cloudflare.com > Turnstile > Add site.
# VITE_TURNSTILE_SITE_KEY=tu-site-key-publica
